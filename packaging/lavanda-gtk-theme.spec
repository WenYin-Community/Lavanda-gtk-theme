Name:           lavanda-gtk-theme
Version:        1.1.0
Release:        1%{?dist}
Summary:        Lavanda GTK theme suite

License:        GPL-3.0-or-later
URL:            https://github.com/WenYin-Community/Lavanda-gtk-theme
Source0:        %{url}/releases/download/v%{version}/Lavanda-gtk-theme-%{version}.tar.gz

BuildArch:      noarch
Requires:       sassc

%description
Lavanda is an elegant GTK theme for GTK 2/3/4 and GNOME Shell 3.28–51,
with Cinnamon, XFCE and MATE support. Themes are compiled on the target
system so that the GNOME Shell styles match the installed shell version.

%prep
%autosetup -n Lavanda-gtk-theme-%{version}

%build
# The stylesheets are generated by install.sh on the target system.

%install
install -d %{buildroot}%{_datadir}/lavanda-gtk-theme
cp -a install.sh build.sh src %{buildroot}%{_datadir}/lavanda-gtk-theme/

%post
# Compile and install all variants for the GNOME Shell version on this system.
%{_datadir}/lavanda-gtk-theme/install.sh -s standard compact || \
  echo "lavanda-gtk-theme: theme installation failed; run %{_datadir}/lavanda-gtk-theme/install.sh manually"
rm -f %{_datadir}/lavanda-gtk-theme/src/sass/gnome-shell/_common-temp.scss

%preun
if [ "$1" -eq 0 ]; then
  %{_datadir}/lavanda-gtk-theme/install.sh -u || :
fi

%files
%license LICENSE
%doc README.md
%{_datadir}/lavanda-gtk-theme

